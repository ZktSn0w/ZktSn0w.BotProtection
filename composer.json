{
    "description": "Extensible Neos package for bot/crawler detection via User-Agent with Fusion prototypes, Eel helpers, and a swappable PHP service layer.",
    "type": "neos-package",
    "name": "zktsn0w/botprotection",
    "version": "1.0",
    "require": {
        "neos/flow": "*",
        "jaybizzle/crawler-detect": "^1.4",
        "neos/neos": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "ZktSn0w\\BotProtection\\": "Classes/"
        }
    },
    "extra": {
        "neos": {
            "package-key": "ZktSn0w.BotProtection"
        }
    },
    "config": {
        "allow-plugins": {
            "neos/composer-plugin": true
        }
    }
}
