prototype(ZktSn0w.BotProtection:BotProtectedContent) {
  @class = 'ZktSn0w\\BotProtection\\Fusion\\BotProtectedContentImplementation'
  fallback = null
  content = null
  identifier = null
  @context.identifierForCacheTag = ${this.identifier}

  @cache {
    mode = 'dynamic'
    entryIdentifier {
      isBot = ${ZktSn0w.BotProtection.isBot(request.httpRequest) ? "is-bot" : "not-a-bot"}
    }

    context {
      1 = 'identifierForCacheTag'
    }

    entryTags {
      1 = ${identifierForCacheTag ? "zktsn0w_botprotection__" + identifierForCacheTag : null}
    }
  }
}
